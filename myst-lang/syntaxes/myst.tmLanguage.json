{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Myst",
  "scopeName": "source.ms",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#strings" },
    { "include": "#chars" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.number-sign.ms",
        "match": "//.*$"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.ms",
        "match": "\\b(func|var|if|elseif|else|while|break|skip|return|and|or|not)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.ms",
        "match": "\\b(string|char|int|decimal|bool)\\b"
      }]
    },
    "constants": {
      "patterns": [{
        "name": "constant.language.boolean.ms",
        "match": "\\b(true|false)\\b"
      }]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.ms",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.ms",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arithmetic.ms",
          "match": "[\\+\\-\\*\\/\\%\\=\\^]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.ms",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ms",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [{
        "name": "string.quoted.double.ms",
        "begin": "\"",
        "end": "\"",
        "patterns": [
          {
            "name": "constant.character.escape.ms",
            "match": "\\\\."
          }
        ]
      }]
    },
    "chars": {
      "patterns": [{
        "name": "constant.character.literal.ms",
        "match": "'([^'\\\\]|\\\\.)'"
      }]
    }
  }
}